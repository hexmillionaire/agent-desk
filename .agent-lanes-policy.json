{
  "version": 1,
  "lanes": {
    "development": {
      "allow": [
        "src/**",
        "bin/**",
        "public/**",
        "vendor/**",
        "test/**",
        "scripts/**",
        "docs/**",
        "*.md",
        "package.json",
        "package-lock.json",
        ".github/**",
        ".gitignore",
        "llms.txt"
      ],
      "deny": [
        ".agent-lanes-policy.json",
        "LICENSE"
      ]
    },
    "docs": {
      "allow": [
        "docs/**",
        "*.md",
        "llms.txt"
      ],
      "deny": [
        "SECURITY.md"
      ]
    }
  }
}
