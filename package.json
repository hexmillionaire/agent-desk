{
  "name": "@hexmillionaire/agent-desk",
  "version": "0.4.1",
  "description": "Zero-dependency localhost dashboard for Agent Lanes: see AI coding-agent task scopes, out-of-scope Git changes, notes and copyable handoffs.",
  "type": "module",
  "bin": {
    "agent-desk": "bin/agent-desk.mjs"
  },
  "files": [
    "bin",
    "src",
    "public",
    "vendor",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node bin/agent-desk.mjs",
    "demo": "node bin/agent-desk.mjs --demo",
    "test": "node --test",
    "test:package": "node scripts/package-smoke.mjs",
    "test:vendor": "node scripts/verify-vendor.mjs"
  },
  "engines": {
    "node": ">=24.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmillionaire/agent-desk.git"
  },
  "homepage": "https://github.com/hexmillionaire/agent-desk#readme",
  "bugs": {
    "url": "https://github.com/hexmillionaire/agent-desk/issues"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "coding-agent",
    "dashboard",
    "localhost",
    "git",
    "scope",
    "handoff",
    "task-scope",
    "agent-lanes"
  ],
  "publishConfig": {
    "access": "public"
  }
}
